# Backend Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# MongoDB Configuration (Local Development)
# ============================================
# For local development, use simple MONGODB_URL
MONGODB_URL=mongodb://localhost:27017/ctf_platform

# ============================================
# MongoDB Configuration (Northflank - Auto-synced)
# ============================================
# When deployed on Northflank, these variables are automatically
# provided by the MongoDB addon. You don't need to set them manually.
# The backend will automatically use these if MONGODB_URL is not set.
#
# Auto-synced variables from Northflank (with NF_SAKI_DB_ prefix):
# - NF_SAKI_DB_MONGO_SRV (Full connection string - preferred)
# - NF_SAKI_DB_HOST (MongoDB host)
# - NF_SAKI_DB_PORT (MongoDB port)
# - NF_SAKI_DB_USERNAME (MongoDB username)
# - NF_SAKI_DB_PASSWORD (MongoDB password)
# - NF_SAKI_DB_DATABASE (Database name)
# - NF_SAKI_DB_MONGO_SRV_ADMIN (Admin connection string)
# - NF_SAKI_DB_TLS_ENABLED (TLS enabled flag)
# - NF_SAKI_DB_HOSTS_LIST (List of hosts)
# - NF_SAKI_DB_ADMIN_USERNAME (Admin username)
# - NF_SAKI_DB_ADMIN_PASSWORD (Admin password)
# - NF_SAKI_DB_MONGO_SRV_OPLOG (Oplog connection string)
# - NF_SAKI_DB_OPLOG_USERNAME (Oplog username)
# - NF_SAKI_DB_OPLOG_PASSWORD (Oplog password)
#
# Note: The prefix "NF_SAKI_DB_" comes from the addon name "saki-db"

# ============================================
# Azure Configuration
# ============================================
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=ctf-platform-rg

# ============================================
# CORS Configuration (comma-separated list)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://saki.02labs.me

# ============================================
# Authentication Configuration
# ============================================
# JWT secret key for token signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
JWT_SECRET_KEY=your-secret-key-change-this-in-production
JWT_ALGORITHM=HS256

# Encryption key for 2FA secrets (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-encryption-key-change-this-in-production

# ============================================
# Email Configuration (SMTP)
# ============================================
# SMTP server settings
# Options:
# - Gmail: smtp.gmail.com (port 587)
# - iCloud: smtp.mail.me.com (port 587)
# - Outlook: smtp-mail.outlook.com (port 587)
# - Custom: your-smtp-server.com
SMTP_HOST=smtp.mail.me.com
SMTP_PORT=587

# SMTP authentication
# For iCloud: Use your iCloud email and an App-Specific Password
# Generate App Password: https://appleid.apple.com/account/manage
# (Sign-In and Security > App-Specific Passwords)
#
# For Gmail: Use your Gmail address and an App Password
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password

# Email sender information
# SMTP_FROM: The email address that appears as the sender
# SMTP_FROM_NAME: The name that appears as the sender
# Note: SMTP_FROM should match SMTP_USER to avoid delivery issues
SMTP_FROM=your-email@example.com
SMTP_FROM_NAME=Saki - Agentic CTF Solver Orchestration

# ============================================
# Application Configuration
# ============================================
LOG_LEVEL=INFO
