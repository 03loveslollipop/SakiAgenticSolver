# Backend Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# MongoDB Configuration (Local Development)
# ============================================
# For local development, use simple MONGODB_URL
MONGODB_URL=mongodb://localhost:27017/ctf_platform

# ============================================
# MongoDB Configuration (Northflank - Auto-synced)
# ============================================
# When deployed on Northflank, these variables are automatically
# provided by the MongoDB addon. You don't need to set them manually.
# The backend will automatically use these if MONGODB_URL is not set.
#
# Auto-synced variables from Northflank:
# - MONGO_SRV (e.g., cluster.mongodb.net)
# - USERNAME (MongoDB username)
# - PASSWORD (MongoDB password)
# - DATABASE (Database name)
# - HOST (MongoDB host)
# - PORT (MongoDB port)
# - MONGO_SRV_ADMIN (Admin connection string)
# - TLS_ENABLED (TLS enabled flag)
# - HOSTS_LIST (List of hosts)
# - ADMIN_USERNAME (Admin username)
# - ADMIN_PASSWORD (Admin password)
# - MONGO_SRV_OPLOG (Oplog connection string)
# - OPLOG_USERNAME (Oplog username)
# - OPLOG_PASSWORD (Oplog password)

# ============================================
# Azure Configuration
# ============================================
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=ctf-platform-rg

# ============================================
# CORS Configuration (comma-separated list)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://saki.02labs.me

# ============================================
# Application Configuration
# ============================================
LOG_LEVEL=INFO
