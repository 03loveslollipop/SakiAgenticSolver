# Backend Environment Variables Example
# Copy this file to .env and fill in your values

# ============================================
# MongoDB Configuration (Local Development)
# ============================================
# For local development, use simple MONGODB_URL
MONGODB_URL=mongodb://localhost:27017/ctf_platform

# ============================================
# MongoDB Configuration (Northflank - Auto-synced)
# ============================================
# When deployed on Northflank, these variables are automatically
# provided by the MongoDB addon. You don't need to set them manually.
# The backend will automatically use these if MONGODB_URL is not set.
#
# Auto-synced variables from Northflank (with NF_SAKI_DB_ prefix):
# - NF_SAKI_DB_MONGO_SRV (Full connection string - preferred)
# - NF_SAKI_DB_HOST (MongoDB host)
# - NF_SAKI_DB_PORT (MongoDB port)
# - NF_SAKI_DB_USERNAME (MongoDB username)
# - NF_SAKI_DB_PASSWORD (MongoDB password)
# - NF_SAKI_DB_DATABASE (Database name)
# - NF_SAKI_DB_MONGO_SRV_ADMIN (Admin connection string)
# - NF_SAKI_DB_TLS_ENABLED (TLS enabled flag)
# - NF_SAKI_DB_HOSTS_LIST (List of hosts)
# - NF_SAKI_DB_ADMIN_USERNAME (Admin username)
# - NF_SAKI_DB_ADMIN_PASSWORD (Admin password)
# - NF_SAKI_DB_MONGO_SRV_OPLOG (Oplog connection string)
# - NF_SAKI_DB_OPLOG_USERNAME (Oplog username)
# - NF_SAKI_DB_OPLOG_PASSWORD (Oplog password)
#
# Note: The prefix "NF_SAKI_DB_" comes from the addon name "saki-db"

# ============================================
# Azure Configuration
# ============================================
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret
AZURE_TENANT_ID=your-tenant-id
AZURE_RESOURCE_GROUP=ctf-platform-rg

# ============================================
# CORS Configuration (comma-separated list)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://saki.02labs.me

# ============================================
# Application Configuration
# ============================================
LOG_LEVEL=INFO
