# Development mode flag
# Set to 'true' for local development (uses http://localhost:8000)
# Set to 'false' or omit for production (uses https://api.saki.02labs.me)
VITE_DEV=true

# Backend API URL (optional override)
# If VITE_DEV is true, this is ignored and localhost is used
# If VITE_DEV is false, this overrides the default production URL
# VITE_API_BASE_URL=https://api.saki.02labs.me
