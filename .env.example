# GitHub Secrets Configuration
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git!

# ============================================
# Northflank Configuration
# ============================================

# Get these from Northflank dashboard
NORTHFLANK_API_KEY=your-northflank-api-key-here
NORTHFLANK_PROJECT_ID=your-project-id-here
NORTHFLANK_SERVICE_ID=your-service-id-here
NORTHFLANK_CREDENTIALS_ID=your-credentials-id-here

# ============================================
# Azure Configuration
# ============================================

# Azure subscription and authentication
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
AZURE_TENANT_ID=your-azure-tenant-id

# Azure resource group for VMs
AZURE_RESOURCE_GROUP=ctf-platform-rg

# ============================================
# Optional: Backend URL (for verification)
# ============================================

# Your Northflank backend URL (optional, for testing)
# BACKEND_URL=https://ctf-backend-xxx.northflank.app

# ============================================
# Optional: Vercel Configuration
# ============================================

# Only needed if using GitHub Actions to deploy to Vercel
# (Vercel's automatic deployment is recommended instead)
# VERCEL_TOKEN=your-vercel-token
# VERCEL_ORG_ID=your-vercel-org-id
# VERCEL_PROJECT_ID=your-vercel-project-id

# ============================================
# Instructions
# ============================================

# 1. Copy this file: cp .env.example .env
# 2. Fill in all values above
# 3. Run: chmod +x scripts/upload-secrets.sh
# 4. Run: ./scripts/upload-secrets.sh
# 5. Verify secrets in GitHub: Settings → Secrets and variables → Actions
